# ---------------------------------------------------------------------------
# MiGaKu Labs — environment variables
# Add these in Vercel > Project > Settings > Environment Variables, then redeploy.
# All are server-side only. Never prefix keys with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Prompt Forge model providers (add only the ones you use) ---

# GPT-6.1 Sol, GPT-6.1 Terra
OPENAI_API_KEY=
# Claude Haiku 5.5
ANTHROPIC_API_KEY=
# DeepSeek Flash
DEEPSEEK_API_KEY=
# GLM 5.3 Flash, plus the web search used by DeepSeek, GLM and MiMo
ZAI_API_KEY=
# Xiaomi MiMo V2.6 Pro / Flash (pay-as-you-go sk- key from platform.xiaomimimo.com)
MIMO_API_KEY=

# --- Cost protection ---

# Lab key that unlocks unlimited runs for you and friends. Empty = no key option.
FORGE_ACCESS_CODE=
# Free runs per visitor per hour. 0 = lab key required for every run.
FORGE_FREE_RUNS_PER_HOUR=10
# Optional ceiling on free runs per day across all visitors.
# FORGE_DAILY_RUN_CAP=300

# Durable rate limits (recommended in production). Adding Upstash Redis from the
# Vercel Marketplace sets these for you (KV_REST_API_URL / KV_REST_API_TOKEN also work).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optional ---

# Used for social cards and metadata
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Extra origins allowed to call /api/forge (comma-separated)
# FORGE_ALLOWED_ORIGINS=https://your-domain.com

# Endpoint overrides (API roots, no trailing path)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_SEARCH_BASE_URL=https://api.z.ai/api/paas/v4
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Wire model id overrides, if a provider renames a model
# MODEL_GPT_6_1_SOL=gpt-6.1-sol
# MODEL_MIMO_V2_6_PRO=mimo-v2.6-pro

# --- Reserved for upcoming instruments ---
# EXP-002 Music Maker
# PIXAZO_API_KEY=

# --- Local UI testing only (ignored in production builds) ---
# FORGE_MOCK=1
